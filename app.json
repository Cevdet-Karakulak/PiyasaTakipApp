{
  "expo": {
    "name": "PiyasaRadarı",
    "slug": "piyasaradari",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "piyasaradari",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cevdet.piyasaradari",
      "buildNumber": "15",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cevdet.piyasaradari",
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidSdk": "classic",
          "androidAppId": "ca-app-pub-9426623468970945~8428164597",
          "iosAppId": "ca-app-pub-9426623468970945~6133173748",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Bu tanımlayıcı, size daha uygun ve ilgi alanlarınıza yönelik reklamlar sunmak için kullanılacaktır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a60e5255-e158-4bf8-b700-77f76787d980"
      }
    },
    "owner": "floppachesscorps-team"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-9426623468970945~8428164597",
    "ios_app_id": "ca-app-pub-9426623468970945~6133173748",
    "delay_app_measurement_init": true
  }
}
